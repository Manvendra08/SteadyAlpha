# SteadyAlpha Environment Variables
# Copy this file to .env and fill in your values

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Shoonya / Finvasia
SHOONYA_USER=
SHOONYA_PASSWORD=
SHOONYA_API_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_IMEI=
SHOONYA_TOTP_SECRET=
# Optional: use a current manual OTP instead of TOTP secret
SHOONYA_TOTP_VALUE=
# Optional endpoint overrides
SHOONYA_HOST=https://api.shoonya.com/NorenWClientTP/
SHOONYA_WEBSOCKET=wss://api.shoonya.com/NorenWSTP/
SHOONYA_LOGIN_TIMEOUT_SEC=15
SHOONYA_LOGIN_FAILURE_COOLDOWN_SEC=120
# Optional only if Finvasia support asks you to use the legacy route
SHOONYA_ENABLE_LEGACY_HOST_FALLBACK=false
